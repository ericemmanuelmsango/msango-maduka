rules_version = '2';
// QuantVision Mobile — Firebase project: quantvision-eric-bot
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == "ericemmanuelmsango2004@gmail.com"; }
    function keyOk(acct) {
      return exists(/databases/$(database)/documents/qvkeys/$(acct))
        && request.resource.data.k == get(/databases/$(database)/documents/qvkeys/$(acct)).data.key;
    }
    match /qvkeys/{acct} { allow read, write: if isAdmin(); }
    match /qvctl/{acct}  { allow read: if true; allow write: if isAdmin(); }
    match /qv/{acct} {
      allow read, delete: if isAdmin();
      allow create, update: if keyOk(acct);
      match /{col}/{id} {
        allow read, delete: if isAdmin();
        allow create, update: if keyOk(acct);
      }
    }
  }
}
